  <main id="content" role="main">
    <!-- Hero -->
    <div class="container content-space-t-3">
      <div class="row justify-content-lg-between align-items-lg-center">
        <div class="col-lg-5 mb-5 mb-lg-0">
          <div class="mb-5">
            <h1 class="display-4 text-dark mb-5">PyFR</h1>
            <p class="fs-3">An open-source platform for fast, robust and accurate Scale-Resolving Simulations of industrial flow problems.</p>
          </div>

          <div class="d-grid d-sm-flex gap-3 mb-5">
            <a class="btn btn-primary" href="https://github.com/PyFR/PyFR" target="_blank">Get PyFR v3.1</a>
            <a class="btn btn-ghost-dark btn-pointer" href="https://pyfr.readthedocs.io/en/latest/" target="_blank">Documentation</a>
          </div>
        </div>
        <!-- End Col -->

        <div class="col-lg-6">
          <div class="position-relative">
            <div class="position-relative">
              <img class="img-fluid" src="./assets/img/mars-helciopter-comp.jpg" alt="Image Description">

              <!--<div class="position-absolute bottom-0 end-0">
                <img class="w-100" src="./assets/svg/illustrations/cubics.svg" alt="SVG" style="max-width: 30rem;">
              </div>-->
            </div>
          </div>
        </div>
        <!-- End Col -->
      </div>
      <!-- End Row -->
    </div>
    <!-- End Hero -->

    <!-- Icon Blocks -->
    <div class="container content-space-t-2">
      <div class="row">
        <div class="col-sm-6 col-lg mb-5 mb-lg-0">
          <!-- Icon Block -->
          <div class="text-center">
            <div class="mb-3">
              <i class="bi-git fs-1 text-dark"></i>
            </div>

            <h5>Open source</h5>
            <span class="d-block">PyFR is released under a 3-Clause BSD License to enable sharing and collaboration.</span>
          </div>
          <!-- End Icon Block -->
        </div>
        <!-- End Col -->

        <div class="col-sm-6 col-lg mb-5 mb-lg-0">
          <!-- Icon Block -->
          <div class="text-center">
            <div class="mb-3">
              <i class="bi-graph-up fs-1 text-dark"></i>
            </div>

            <h5>High-order accurate</h5>
            <span class="d-block">PyFR utilises the Flux Reconstruction approach to achieve arbitrary-order spatial accuracy.</span>
          </div>
          <!-- End Icon Block -->
        </div>
        <!-- End Col -->

        <div class="col-sm-6 col-lg">
          <!-- Icon Block -->
          <div class="text-center">
            <div class="mb-3">
              <i class="bi-triangle fs-1 text-dark"></i>
            </div>

            <h5>Unstructured meshes</h5>
            <span class="d-block">PyFR can operate with mixed elements and unstructured meshes to enable simulations of complex geometries.</span>
          </div>
          <!-- End Icon Block -->
        </div>

        <div class="col-sm-6 col-lg mb-5 mb-sm-0">
          <!-- Icon Block -->
          <div class="text-center">
            <div class="mb-3">
              <i class="bi-gpu-card fs-1 text-dark"></i>
            </div>

            <h5>Cross-platform</h5>
            <span class="d-block">PyFR can target a range of hardware including CPUs, Nvidia GPUs, AMD GPUs, Intel GPUs, and Apple GPUs.</span>
          </div>
          <!-- End Icon Block -->
        </div>
        <!-- End Col -->

        <!-- End Col -->
      </div>
      <!-- End Row -->
    </div>
    <!-- End Icon Blocks -->

    <div style="height: 120px"></div>

    <!-- Stats -->
    <div class="container" style="padding-left: 80px !important; padding-right: 80px !important;">
      <div class="w-md-75 w-lg-50 text-center mx-md-auto mb-5 mb-md-9">
        <h2>Challenge and opportunity</h2>
      </div>
      <div class="row justify-content-lg-between align-items-lg-center">
        <div class="col-lg-6">
          <!-- List -->
          <p class="fs-3">
            Reynolds Averaged Navier-Stokes (RANS) simulations are cheap and robust, but accuracy is limited for complex unsteady industrial flows. Scale-Resolving Simulations (SRS) overcome the accuracy limitations of RANS, but can lack robustness, and have historically been too expensive for industrial adoption.

          </p>
          <!-- End List -->
        </div>
        <!-- End Col -->

        <div class="col-lg-5 mb-9 mb-lg-0">

          <!-- Blockquote -->
          <figure>
            <blockquote class="blockquote"><em>The use of CFD in the aerospace design process is
                severely limited by the inability to accurately and reliably predict turbulent flows with significant regions
                of separation.</em></blockquote>

            <figcaption class="blockquote-footer">
              <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                  <img class="avatar avatar-circle" src="./assets/img/logos/nasa.png" alt="Image Description" style="width: 3rem; height: 3rem; object-fit: contain;">
                </div>

                <div class="flex-grow-1 ms-3">
                  NASA Vision 2030 Study
                  <span class="blockquote-footer-source">NASA/CR-2014-218178</span>
                </div>
              </div>
            </figcaption>
          </figure>
          <!-- End Blockquote -->
        </div>
        <!-- End Col -->
      </div>
      <!-- End Row -->
    </div>

    <div style="height: 120px"></div>

    <div class="container" style="padding-left: 80px !important; padding-right: 80px !important;">
      <div class="w-md-75 w-lg-50 text-center mx-md-auto mb-5 mb-md-9">
        <h2>Mission and vision</h2>
      </div>

      <!-- Mission Statement -->
      <div class="row justify-content-center align-items-center">
        <div class="col-lg-2">
          <div class="text-center">
            <img src="./assets/svg/logos/pyfricon.svg" alt="PyFR Icon" style="width: 100px; height: 100px;">
          </div>
        </div>
        <div class="col-lg-10">
          <p class="text-left fs-3 mb-0 pt-lg-0 pt-6">
            Our mission is to develop an SRS capability that is fast and robust,
            with a vision to enable industrial adoption of SRS, and hence a paradigm-shift in industrial design capability.
          </p>
        </div>
      </div>
      <!-- End Mission Statement -->

    </div>
    <!-- End Stats -->

    <div style="height: 120px"></div>

    <!-- Used By Section -->
    <div class="container">
